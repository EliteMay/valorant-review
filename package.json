{
  "name": "vreview",
  "version": "0.11.0",
  "private": true,
  "description": "VALORANT review and aim consistency analyzer",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "validate": "node scripts/validate.mjs",
    "test": "node tests/storage.test.mjs && node tests/detector-metrics.test.mjs && node tests/telemetry-event.test.mjs && node tests/updater-version.test.mjs && node tests/recording-controller.test.mjs && node tests/settings-store.test.mjs && npm run validate",
    "build:win": "npm run build:input-helper && electron-builder --win nsis",
    "dist:win": "npm run build:input-helper && electron-builder --win nsis --publish never",
    "build:input-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-input-helper.ps1"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "io.github.elitemay.vreview",
    "productName": "VReview",
    "asar": true,
    "files": [
      "electron/**/*",
      "css/**/*",
      "data/**/*",
      "js/**/*",
      "*.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VReview-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VReview"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EliteMay",
        "repo": "valorant-review"
      }
    ],
    "extraResources": [
      {
        "from": "native/bin/vreview-input-telemetry.exe",
        "to": "input-helper/vreview-input-telemetry.exe"
      }
    ]
  }
}
