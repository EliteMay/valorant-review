{
  "project": "VReview",
  "guideVersion": "1.22.0",
  "profiles": [
    "STATIC",
    "MEDIA",
    "AI-HANDOFF",
    "TOOL"
  ],
  "sourceOfTruth": {
    "runtimeVersion": "js/version.js",
    "projectSpecification": "SPEC.md",
    "currentOverview": "README.md",
    "projectLearnings": "PROJECT_LEARNINGS.md",
    "agentRouter": "AGENTS.md",
    "workHistory": "作業報告書.md"
  },
  "storage": {
    "schemaVersion": 1,
    "primary": "localStorage",
    "storesMedia": false,
    "feedbackQueue": {
      "backend": "IndexedDB",
      "database": "vreview-feedback-library",
      "schemaVersion": 1,
      "maxItems": 20,
      "maxBytes": 367001600,
      "storesSourceVideo": false,
      "storesGeneratedImages": true
    }
  },
  "diagnostics": {
    "schemaVersion": 1,
    "runtime": "js/diagnostics.js",
    "view": "diagnostics.html",
    "storage": "sessionStorage",
    "maxBreadcrumbs": 120,
    "maxErrors": 40,
    "storesMedia": false,
    "autoUpload": false
  },
  "aiHandoff": {
    "feedbackSchema": "vreview-detector-feedback",
    "feedbackSchemaVersion": 1,
    "packageVersion": 5,
    "batchSchema": "vreview-detector-feedback-batch",
    "batchSchemaVersion": 1
  },
  "visual": {
    "direction": "review-workbench",
    "ambition": "high",
    "primaryDevice": "desktop",
    "primaryContent": "video",
    "desktopComposition": "fixed-video-right-inspector-scroll"
  },
  "deployment": {
    "type": "github-pages",
    "basePath": "/valorant-review/"
  },
  "desktop": {
    "status": "session-recording",
    "runtime": "Electron",
    "appId": "io.github.elitemay.vreview",
    "entry": "electron/main.cjs",
    "preload": "electron/preload.cjs",
    "architecture": "docs/V1_ELECTRON_ARCHITECTURE.md",
    "packaging": "electron-builder/nsis",
    "sourceVideoAutoUpload": false,
    "gameplayAutomation": false,
    "inputTelemetry": {
      "schema": "data/input-telemetry-schema.json",
      "helper": "native/input-telemetry/main.cpp",
      "controller": "electron/telemetry/controller.cjs",
      "allowedMouse": [
        "dx",
        "dy",
        "LMB"
      ],
      "allowedKeys": [
        "W",
        "A",
        "S",
        "D"
      ],
      "textInput": false,
      "clipboard": false,
      "processInjection": false,
      "processMemoryRead": false,
      "inputAutomation": false,
      "foregroundGate": "foreground-window-title-only"
    },
    "gameplayRecording": {
      "schema": "data/recording-schema.json",
      "controller": "electron/recording/controller.cjs",
      "renderer": "js/desktop-telemetry.js",
      "output": "gameplay.webm",
      "manifest": "recording.json",
      "capture": "Electron desktopCapturer + getDisplayMedia + MediaRecorder",
      "source": "primary-display",
      "targetFrameRate": 60,
      "targetResolution": "1920x1080",
      "systemAudioLoopback": true,
      "processHandle": false,
      "processMemoryRead": false,
      "processInjection": false,
      "inputAutomation": false,
      "overlay": false
    }
  },
  "analysisModel": {
    "canonicalConcepts": [
      "Session",
      "Duel",
      "AnalysisRun"
    ],
    "sessionSchema": "data/session-schema.json",
    "duelSchema": "data/duel-schema.json",
    "analysisRunSchema": "data/analysis-run-schema.json",
    "legacyDetector": "0.5.0"
  }
}
